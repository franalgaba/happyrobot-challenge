NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/happyrobot_challenge
API_KEY=replace-with-a-random-api-key
MCP_PATH_TOKEN=replace-with-a-random-mcp-path-token
MCP_AUTH_TOKEN=replace-with-a-random-mcp-bearer-token
PUBLIC_API_BASE_URL=http://localhost:3000

HAPPYROBOT_API_KEY=
HAPPYROBOT_CLUSTER=us
HAPPYROBOT_WORKFLOW_ID=
HAPPYROBOT_WORKFLOW_NAME=Inbound Carrier Sales POC
HAPPYROBOT_ENVIRONMENT=production

FMCSA_WEB_KEY=
ALLOW_SEEDED_CARRIER_FALLBACK=true
DEMO_CARRIER_MC_NUMBERS=123456,654321,777888

# Comma-separated browser origins allowed to call /api (dashboard)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080

# Dashboard (apps/web) — copy to apps/web/.env.local for local dev
# API_BASE_URL=http://localhost:3000
# API_KEY=replace-with-a-random-api-key
# VITE_CLIENT_NAME=Acme Logistics
