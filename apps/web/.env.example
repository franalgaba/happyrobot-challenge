# BFF runtime (Vite dev + server.mjs) — never VITE_* for API secrets.
# Copy to .env.local (gitignored) for real values.
# Public API example: API_BASE_URL=https://<your-api-service>.up.railway.app
API_BASE_URL=http://localhost:3000
API_KEY=replace-with-a-random-api-key

# Web Call: POST /api/voice/token uses the same BFF + API_KEY (browser never sees the key).
# Optional: VOICE_TOKEN_ENVIRONMENT=production  VOICE_TOKEN_TTL_SECONDS=3600

VITE_CLIENT_NAME=Acme Logistics
